PORT=3000
FRONTEND_URL=http://localhost:5173

# Server-only: never expose these as VITE_ variables. Apply SQL migrations manually.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters; changing this resets the effective network buckets.
TYPING_RATE_LIMIT_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Durable per-HMAC-network fixed-window limits (reads: 1 minute; writes: 10 minutes).
TYPING_READ_LIMIT=120
TYPING_SESSION_LIMIT=20
TYPING_SAVE_LIMIT=30
# VERCEL=1 is set by the platform; do not set it for an untrusted local proxy.
